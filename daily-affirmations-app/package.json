{
  "name": "daily-affirmations-app",
  "version": "1.0.0",
  "description": "Uma aplicação web moderna que oferece afirmações diárias para promover bem-estar mental e crescimento pessoal",
  "main": "index.html",
  "scripts": {
    "start": "npx serve . -l 3000 -s",
    "dev": "npx serve . -l 3000 -s",
    "serve": "npx serve . -p 3000",
    "build": "echo 'No build process needed for vanilla JS app'",
    "test": "echo 'Tests will be implemented in future versions'",
    "validate": "node -c src/script.js && node -e \"JSON.parse(require('fs').readFileSync('src/affirmations.json'))\"",
    "deploy": "vercel --prod",
    "docker:start": "npx serve . -l 3000 -s --no-clipboard"
  },
  "keywords": [
    "affirmations",
    "wellbeing",
    "mental-health",
    "positivity",
    "mindfulness",
    "spa",
    "javascript",
    "responsive",
    "monetization",
    "adterra"
  ],
  "author": {
    "name": "Daily Affirmations Team",
    "email": "contact@dailyaffirmations.app",
    "url": "https://github.com/your-username/daily-affirmations-app"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/daily-affirmations-app.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/daily-affirmations-app/issues"
  },
  "homepage": "https://daily-affirmations-app.vercel.app",
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "serve": "^14.2.0"
  },
  "devDependencies": {
    "lighthouse": "^10.4.0",
    "html-validate": "^8.7.4"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "files": [
    "index.html",
    "src/",
    "docs/",
    "README.md",
    "LICENSE"
  ]
}